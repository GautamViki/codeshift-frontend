# ==============================================================================
# Environment Configuration Template (.env.example)
# Copy this file to `.env.development` or `.env.production` and adjust values.
# Note: Vite exposes variables prefixed with `VITE_` to client-side code.
# ==============================================================================

# Application Environment (e.g. development, production)
VITE_APP_ENV=development
VITE_APP_NAME=CodeShift

# Backend API Base URL
# Development: http://localhost:8080
# Production: https://api.yourdomain.com
VITE_API_BASE_URL=http://localhost:8080
